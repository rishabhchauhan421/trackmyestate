# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Canonical production URL, used for metadata (canonical links, Open Graph,
# sitemap.xml, robots.txt).
NEXT_PUBLIC_SITE_URL="https://trackmyestate.app"

# Google Tag Manager container id. Not a secret (it's embedded in every page's
# HTML), but optional — the container is only loaded when this is set.
NEXT_PUBLIC_GTM_ID="GTM-WZC934WM"

# Better Auth
# Secret used by Better Auth
BETTER_AUTH_SECRET=""

# Better Auth Google OAuth
BETTER_AUTH_GOOGLE_CLIENT_ID=""
BETTER_AUTH_GOOGLE_CLIENT_SECRET=""

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="postgresql://postgres:password@localhost:5432/trackmyestate"

# Notification engine
# https://src/server/notifications — dispatches due `NotificationJob` rows
# over email (live), WhatsApp and SMS (placeholders, see below).

# Email (phase 1, live) — https://resend.com/api-keys
RESEND_API_KEY=""
# "From" address used for all outgoing notification emails. Must be on a
# domain verified with Resend.
NOTIFICATIONS_EMAIL_FROM="notifications@trackmyestate.app"

# Shared secret the notification cron route checks on every trigger request
# (see `src/app/api/cron/notifications/route.ts`). Generate with:
# openssl rand -hex 32
CRON_SECRET=""

# WhatsApp (phase 2, not yet implemented — placeholder only; see
# `src/server/notifications/channels/whatsapp.ts`). Expected shape: a Meta
# WhatsApp Cloud API token + phone number id.
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# SMS (phase 2, not yet implemented — placeholder only; see
# `src/server/notifications/channels/sms.ts`).
SMS_API_KEY=""
SMS_SENDER_ID=""
