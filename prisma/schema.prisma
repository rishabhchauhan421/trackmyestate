// Prisma schema for Better Auth & Asset Management Platform
// Database: MongoDB

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core / Auth Models
// ---------------------------------------------------------------------------

model User {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  currency Currency @default(INR)

  // IANA time zone (e.g. "Asia/Kolkata") for reminder send times and "today"
  // in date logic. Optional so existing users need no backfill — null means
  // `DEFAULT_TIME_ZONE` in `src/lib/time-zone.ts`. Set from Settings.
  timezone String?

  // Mobile number for SMS/WhatsApp reminders, E.164 ("+919876543210").
  // Saved from Settings › Channels; verification and delivery aren't
  // built yet, so nothing is sent to it.
  phone String?

  // Local hour (0-23) reminders are sent at; null = 9 am. See
  // `src/server/reminders/generate.ts`.
  reminderHour Int?

  // better-auth `admin` plugin fields (see `src/server/better-auth/config.ts`).
  // All optional: existing users have none of these set and are treated as
  // ordinary, unbanned, non-admin users until explicitly promoted/banned —
  // see `scripts/set-admin-role.ts`.
  role       String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions   Session[]
  households HouseholdMember[]
  accounts   Account[]

  // Domain relations
  guests            Guest[]
  properties        Property[]
  policies          Policy[]
  investments       Investment[]
  loans             Loan[]
  bills             Bill[]
  billSchedules     BillSchedule[]
  notificationRules NotificationRule[]
  notificationJobs  NotificationJob[]
  documents         Document[]
  auditLogs         AuditLog[]
  transactions      PaymentTransaction[]

  @@map("user")
}

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // better-auth `admin` plugin: set on an admin's session while they're
  // impersonating another user (holds the admin's own user id).
  impersonatedBy String?

  @@map("session")
}

model Account {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  accountId             String
  providerId            String
  userId                String    @db.ObjectId
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ---------------------------------------------------------------------------
// Embedded Document Types (MongoDB Native)
// ---------------------------------------------------------------------------

// A dated milestone on a `PropertyIssue` (next hearing, filing deadline,
// expected decision). `date` is a date-only value (see
// src/lib/calendar-day.ts). `id` is a uuid, so alerts can be keyed to it.
type IssueKeyDate {
  id    String
  label String
  date  DateTime
  done  Boolean  @default(false)
}

// One entry in a `PropertyIssue`'s dated log.
type IssueNote {
  id         String
  at         DateTime
  authorName String
  text       String
}

type Recipient {
  name         String
  email        String
  phone        String?
  notifyOnDue  Boolean @default(true)
  notifyOnPaid Boolean @default(false)
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Currency {
  INR
  USD
  EUR
  GBP
  CAD
  AED
  SGD
  AUD
}

enum PropertyType {
  SELF_OCCUPIED
  RENTED
  UNDER_CONSTRUCTION
  INVESTMENT
}

enum PropertyCategory {
  APARTMENT
  SINGLE_FAMILY_HOUSE
  OFFICE
  SHOP
  CONDOMINIUM
  TOWN_HOUSE
  MULTI_FAMILY_HOUSE
  FACTORY
  WAREHOUSE
  PLOT
  OTHERS
}

enum OwnershipType {
  FREEHOLD
  LEASEHOLD
}

enum BillType {
  ELECTRICITY
  WATER
  PROPERTY_TAX
  MAINTENANCE
  GAS
  INTERNET
  OTHER
}

enum BillingType {
  FIXED
  VARIABLE
}

enum BillRecurrence {
  WEEKLY
  BI_WEEKLY
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum PaymentStatus {
  DUE
  PAID
  OVERDUE
  PARTIALLY_PAID
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  UPI
  CHEQUE
  AUTO_DEBIT
  OTHER
}

enum PolicyType {
  TERM_LIFE
  ENDOWMENT
  MONEY_BACK
  ULIP
  HEALTH
  VEHICLE
  HOME
}

enum PolicyStatus {
  ACTIVE
  LAPSED
  MATURED
  CLAIMED
  CANCELLED
}

enum PremiumFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  SINGLE
}

enum ClaimStatus {
  FILED
  APPROVED
  REJECTED
  SETTLED
}

enum InvestmentType {
  PROPERTY
  FIXED_DEPOSIT
  RECURRING_DEPOSIT
  MUTUAL_FUND
  STOCKS
  GOLD
  BUSINESS
  PPF
  NPS
}

enum LoanType {
  HOME_LOAN
  LOAN_AGAINST_PROPERTY
  PERSONAL_LOAN
  VEHICLE_LOAN
  EDUCATION_LOAN
  GOLD_LOAN
}

enum EventCategory {
  RENT
  UTILITY_BILL
  PREMIUM
  EMI
  INVESTMENT_RETURN
  PAYOUT
  CLAIM_SETTLEMENT
  CUSTOM
  // A one-off amount due on a property (a builder instalment, conversion
  // charges, stamp duty, a settlement), optionally under a `PropertyIssue`.
  PROPERTY_DUE
}

// What stops a property from being fully clear. The type only sets the
// wording; every type can hold payments and key dates.
enum PropertyIssueType {
  DISPUTE
  FREEHOLD_CONVERSION
  PENDING_DUES
  REGISTRATION
  OTHER
}

enum PropertyIssueStatus {
  OPEN
  RESOLVED
  // No longer applies (added by mistake, withdrawn, superseded).
  DROPPED
}

enum FinancialEventType {
  INFLOW
  OUTFLOW
}

enum ReminderChannel {
  EMAIL
  PUSH
  WHATSAPP
  SMS
}

// The date a reminder's `offsetDays` is measured from. Only the bill's due
// date exists today; e.g. a policy's grace-period end can be added once
// `Policy` stores its grace period.
enum ReminderAnchor {
  DUE_DATE
}

enum NotificationStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  CANCELLED
  SKIPPED
}

// ---------------------------------------------------------------------------
// Domain Models — Real Estate, Rental & Utility Tracking
// ---------------------------------------------------------------------------

model Property {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  ownerId     String     @db.ObjectId
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Who can see and change this record: everyone in the household (see
  // `Household`). `ownerId` stays as the person who created it. Optional
  // only so records saved before households existed still load; every write
  // sets it, and `ensureHousehold` backfills older ones.
  householdId String?    @db.ObjectId
  household   Household? @relation(fields: [householdId], references: [id])

  name             String
  type             PropertyType
  uniquePropertyId String?
  propertyCategory PropertyCategory?
  ownershipType    OwnershipType?
  addressLine1     String
  addressLine2     String?
  city             String
  state            String
  pinCode          String
  country          String            @default("India")

  currency              Currency?
  purchasePrice         Float?
  currentEstimatedValue Float?
  purchaseDate          DateTime?
  photos                String[]

  // Opt-in for a leasehold property: when the owner switched on freehold
  // check-ins, sent every six months from this day until it's converted
  // (see src/server/issues/alerts.ts). Unset = off.
  freeholdAlertsSince DateTime?

  // Free text for whatever the fields above can't hold.
  notes String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  rooms             Room[]
  leases            Lease[]
  issues            PropertyIssue[]
  policies          Policy[] // Insurance policies covering this property
  billSchedules     BillSchedule[]
  bills             Bill[]
  loans             Loan[] // If property is linked to a loan
  documents         Document[]
  transactions      PaymentTransaction[]
  notificationRules NotificationRule[]
  notificationJobs  NotificationJob[]

  @@index([ownerId, deletedAt])
  @@index([householdId])
}

model Room {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  propertyId String   @db.ObjectId
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  label      String
  floor      String?
  areaSqft   Float?

  // occupancyStatus removed — derived dynamically in queries based on active Lease

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  leases    Lease[]
  documents Document[]

  @@index([propertyId, deletedAt])
}

model Lease {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  propertyId String   @db.ObjectId
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomId     String?  @db.ObjectId
  room       Room?    @relation(fields: [roomId], references: [id])

  tenantName    String    @map("name")
  // Optional: older leases all have one, new ones may not.
  tenantPhone   String?   @map("phone")
  tenantEmail   String?   @map("email")
  leaseStart    DateTime
  leaseEnd      DateTime?
  rentAmount    Float
  rentDueDay    Int?
  depositAmount Float
  currency      Currency?
  active        Boolean   @default(true)

  // Free text for whatever the fields above can't hold.
  notes String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  billSchedules     BillSchedule[]
  bills             Bill[]
  documents         Document[]
  transactions      PaymentTransaction[]
  notificationRules NotificationRule[]
  notificationJobs  NotificationJob[]

  @@index([propertyId, deletedAt])
  @@index([roomId])
  @@map("Tenant")
}

// ---------------------------------------------------------------------------
// BillSchedule & Bills (Exclusive Arcs replace Polymorphic Strings)
// ---------------------------------------------------------------------------

model BillSchedule {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  ownerId     String     @db.ObjectId
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Who can see and change this record: everyone in the household (see
  // `Household`). `ownerId` stays as the person who created it. Optional
  // only so records saved before households existed still load; every write
  // sets it, and `ensureHousehold` backfills older ones.
  householdId String?    @db.ObjectId
  household   Household? @relation(fields: [householdId], references: [id])

  category EventCategory

  // Exclusive Arcs (Only one will be populated per row)
  propertyId   String?     @db.ObjectId
  property     Property?   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leaseId      String?     @db.ObjectId
  lease        Lease?      @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  loanId       String?     @db.ObjectId
  loan         Loan?       @relation(fields: [loanId], references: [id], onDelete: Cascade)
  policyId     String?     @db.ObjectId
  policy       Policy?     @relation(fields: [policyId], references: [id], onDelete: Cascade)
  investmentId String?     @db.ObjectId
  investment   Investment? @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  billType         BillType?
  provider         String?
  accountNumber    String?
  meterNumber      String?
  billingType      BillingType?
  autoGenerateBill Boolean?

  recurrence    BillRecurrence @default(MONTHLY)
  // The first due date (a date-only value — see src/lib/calendar-day.ts).
  // Anchors every recurrence: which months a quarterly bill falls in,
  // which weekday a weekly one does, and where an EMI's tenure starts.
  // Older schedules without it are anchored on their creation date.
  startDate     DateTime?
  dueDay        Int
  dueMonth      Int?
  // Last day a bill can fall on (e.g. a lease's end date). No end if unset.
  endDate       DateTime?
  // The first due day the generator hasn't billed yet (date-only), so each
  // run reads only schedules with something due soon. Set to `startDate`
  // whenever the terms change; null once there's nothing left to bill. A
  // schedule without one yet is always read (and gets one).
  nextDueDate   DateTime?
  // The earliest day the generator may bill (date-only): the day the terms
  // were last changed, or the day a schedule that started long ago was
  // added. Stops its catch-up window from creating bills for days that had
  // already passed. Unset = no limit beyond `startDate`.
  billFrom      DateTime?
  defaultAmount Float?
  currency      Currency?
  tenureMonths  Int?

  active    Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  recipients Recipient[] // MongoDB Embedded Array

  bills             Bill[]
  documents         Document[]
  notificationRules NotificationRule[]
  notificationJobs  NotificationJob[]

  @@index([ownerId, deletedAt])
  @@index([propertyId])
  @@index([leaseId])
  @@index([loanId])
  @@index([policyId])
  @@index([householdId])
  @@index([active, nextDueDate])
}

model Bill {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  ownerId     String     @db.ObjectId
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Who can see and change this record: everyone in the household (see
  // `Household`). `ownerId` stays as the person who created it. Optional
  // only so records saved before households existed still load; every write
  // sets it, and `ensureHousehold` backfills older ones.
  householdId String?    @db.ObjectId
  household   Household? @relation(fields: [householdId], references: [id])

  category  EventCategory
  direction FinancialEventType

  // Exclusive Arcs
  billScheduleId  String?        @db.ObjectId
  billSchedule    BillSchedule?  @relation(fields: [billScheduleId], references: [id], onDelete: SetNull)
  propertyId      String?        @db.ObjectId
  property        Property?      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leaseId         String?        @db.ObjectId
  lease           Lease?         @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  loanId          String?        @db.ObjectId
  loan            Loan?          @relation(fields: [loanId], references: [id], onDelete: Cascade)
  policyId        String?        @db.ObjectId
  policy          Policy?        @relation(fields: [policyId], references: [id], onDelete: Cascade)
  investmentId    String?        @db.ObjectId
  investment      Investment?    @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  // Not an arc of its own: a PROPERTY_DUE bill always has `propertyId`,
  // and this too when it was added under one of the property's issues.
  propertyIssueId String?        @db.ObjectId
  propertyIssue   PropertyIssue? @relation(fields: [propertyIssueId], references: [id], onDelete: SetNull)

  // One key per bill a schedule generates ("<scheduleId>:<YYYY-MM-DD>"), so
  // two overlapping generator runs can't both create it: the second insert
  // fails on the unique index and is skipped. Bills not made by a schedule
  // get a random uuid. Required (with a default) because MongoDB's unique
  // index treats a missing key as a value, so two keyless bills would clash.
  generationKey String @unique @default(uuid())

  dueDate    DateTime
  amount     Float
  currency   Currency?
  status     PaymentStatus @default(DUE)
  paidDate   DateTime?
  paidAmount Float?
  notes      String?

  installmentNumber  Int?
  principalComponent Float?
  interestComponent  Float?
  previousMeterValue Float?
  currentMeterValue  Float?
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  billDocumentUrl    String?
  receiptDocumentUrl String?
  frequency          PremiumFrequency?
  gracePeriodDays    Int?
  label              String?
  claimStatus        ClaimStatus?
  description        String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  transactions      PaymentTransaction[]
  documents         Document[]
  notificationRules NotificationRule[]
  notificationJobs  NotificationJob[]

  @@index([ownerId, deletedAt])
  @@index([dueDate, status])
  @@index([propertyId])
  @@index([leaseId])
  @@index([loanId])
  @@index([householdId])
  @@index([propertyIssueId])
}

// Something that stops a property from being fully clear: a dispute, a
// pending freehold conversion, unpaid dues, a pending registration. It
// carries key dates and a dated log itself; what's owed under it is
// ordinary `Bill`s (category PROPERTY_DUE) pointing back here. Both raise
// alerts until it's resolved or dropped (see src/server/issues/alerts.ts).
model PropertyIssue {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  // Who created it; everyone in `householdId` can see and change it.
  ownerId     String   @db.ObjectId
  householdId String   @db.ObjectId
  propertyId  String   @db.ObjectId
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  type         PropertyIssueType
  status       PropertyIssueStatus @default(OPEN)
  title        String
  description  String?
  // The other side: a person, builder, authority or court.
  counterparty String?
  // A case, application or allotment number.
  reference    String?

  // Date-only values (see src/lib/calendar-day.ts).
  openedOn   DateTime
  resolvedOn DateTime?
  // How it ended, written when it's resolved or dropped.
  outcome    String?

  keyDates IssueKeyDate[]
  notes    IssueNote[]

  // When someone last changed it (a note, a date, a payment added): what
  // the "gone quiet" alert measures from.
  lastActivityAt DateTime @default(now())

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  bills Bill[]

  @@index([propertyId])
  @@index([householdId, status])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Domain Models — Insurance Policies, Investments & Loans
// ---------------------------------------------------------------------------

model Policy {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  ownerId     String     @db.ObjectId
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Who can see and change this record: everyone in the household (see
  // `Household`). `ownerId` stays as the person who created it. Optional
  // only so records saved before households existed still load; every write
  // sets it, and `ensureHousehold` backfills older ones.
  householdId String?    @db.ObjectId
  household   Household? @relation(fields: [householdId], references: [id])

  type                PolicyType
  insurer             String
  policyNumber        String
  holderName          String
  nominees            String[]
  startDate           DateTime
  tenureYears         Int?
  status              PolicyStatus @default(ACTIVE)
  sumAssured          Float?
  currency            Currency?
  roomRentLimit       Float?
  coPayPercent        Float?
  waitingPeriodMonths Int?
  networkHospitals    String[]

  // Optional link — e.g. a HOME policy insuring a specific property
  propertyId String?   @db.ObjectId
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  // Free text for whatever the fields above can't hold.
  notes String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  billSchedules     BillSchedule[]
  bills             Bill[]
  loans             Loan[]
  documents         Document[]
  transactions      PaymentTransaction[]
  notificationRules NotificationRule[]
  notificationJobs  NotificationJob[]

  @@index([ownerId, deletedAt])
  @@index([propertyId])
  @@index([householdId])
}

model Investment {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  ownerId     String     @db.ObjectId
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Who can see and change this record: everyone in the household (see
  // `Household`). `ownerId` stays as the person who created it. Optional
  // only so records saved before households existed still load; every write
  // sets it, and `ensureHousehold` backfills older ones.
  householdId String?    @db.ObjectId
  household   Household? @relation(fields: [householdId], references: [id])

  name                  String
  type                  InvestmentType
  institution           String?
  investedDate          DateTime
  capitalDeployed       Float
  currency              Currency?
  expectedReturnType    String?
  expectedReturnDate    DateTime?
  targetRoiPercent      Float?
  currentEstimatedValue Float?

  // Free text for whatever the fields above can't hold.
  notes String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  billSchedules     BillSchedule[]
  bills             Bill[]
  loans             Loan[]
  documents         Document[]
  transactions      PaymentTransaction[]
  notificationRules NotificationRule[]
  notificationJobs  NotificationJob[]

  @@index([ownerId, deletedAt])
  @@index([householdId])
}

model Loan {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  ownerId     String     @db.ObjectId
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Who can see and change this record: everyone in the household (see
  // `Household`). `ownerId` stays as the person who created it. Optional
  // only so records saved before households existed still load; every write
  // sets it, and `ensureHousehold` backfills older ones.
  householdId String?    @db.ObjectId
  household   Household? @relation(fields: [householdId], references: [id])

  lender              String
  type                LoanType
  principal           Float
  currency            Currency?
  interestRatePercent Float
  startDate           DateTime
  outstandingBalance  Float

  // Exclusive Arcs replace LinkedAssetId
  linkedPropertyId   String?     @db.ObjectId
  linkedProperty     Property?   @relation(fields: [linkedPropertyId], references: [id], onDelete: SetNull)
  linkedPolicyId     String?     @db.ObjectId
  linkedPolicy       Policy?     @relation(fields: [linkedPolicyId], references: [id], onDelete: SetNull)
  linkedInvestmentId String?     @db.ObjectId
  linkedInvestment   Investment? @relation(fields: [linkedInvestmentId], references: [id], onDelete: SetNull)

  // Free text for whatever the fields above can't hold.
  notes String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  billSchedules     BillSchedule[]
  bills             Bill[]
  documents         Document[]
  transactions      PaymentTransaction[]
  notificationRules NotificationRule[]
  notificationJobs  NotificationJob[]

  @@index([ownerId, deletedAt])
  @@index([householdId])
}

// ---------------------------------------------------------------------------
// Universal Payment Ledger & Audit Trail
// ---------------------------------------------------------------------------

model PaymentTransaction {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  ownerId     String     @db.ObjectId
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Who can see and change this record: everyone in the household (see
  // `Household`). `ownerId` stays as the person who created it. Optional
  // only so records saved before households existed still load; every write
  // sets it, and `ensureHousehold` backfills older ones.
  householdId String?    @db.ObjectId
  household   Household? @relation(fields: [householdId], references: [id])

  category EventCategory

  // Exclusive Arcs
  billId       String?     @db.ObjectId
  bill         Bill?       @relation(fields: [billId], references: [id], onDelete: Cascade)
  propertyId   String?     @db.ObjectId
  property     Property?   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leaseId      String?     @db.ObjectId
  lease        Lease?      @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  loanId       String?     @db.ObjectId
  loan         Loan?       @relation(fields: [loanId], references: [id], onDelete: Cascade)
  policyId     String?     @db.ObjectId
  policy       Policy?     @relation(fields: [policyId], references: [id], onDelete: Cascade)
  investmentId String?     @db.ObjectId
  investment   Investment? @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  amount          Float
  currency        Currency?
  paymentMethod   PaymentMethod @default(BANK_TRANSFER)
  referenceNumber String?
  receiptUrl      String?

  paidAt DateTime @default(now())
  notes  String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([ownerId, deletedAt])
  @@index([billId])
  @@index([householdId])
}

model AuditLog {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action String

  // Note: These intentionally remain standard Strings. Audit logs are immutable 
  // historical ledgers that must persist even if the source entity is hard-deleted.
  entityType String
  entityId   String @db.ObjectId

  changes   Json?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Scalable Notification Engine
// ---------------------------------------------------------------------------

// One reminder: for `category` bills, remind `offsetDays` from `anchor` on
// `channels`. With no item link set (`billScheduleId`, `loanId`, ...) it's
// the owner's default for that category, edited in Settings › Reminders;
// with one set it overrides the defaults for that item only. An owner with
// no rows for a category gets the built-in defaults in
// `src/server/reminders/defaults.ts`.
model NotificationRule {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  ownerId String @db.ObjectId
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  category EventCategory

  // Exclusive Arcs
  billScheduleId String?       @db.ObjectId
  billSchedule   BillSchedule? @relation(fields: [billScheduleId], references: [id], onDelete: Cascade)
  billId         String?       @db.ObjectId
  bill           Bill?         @relation(fields: [billId], references: [id], onDelete: Cascade)
  propertyId     String?       @db.ObjectId
  property       Property?     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leaseId        String?       @db.ObjectId
  lease          Lease?        @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  loanId         String?       @db.ObjectId
  loan           Loan?         @relation(fields: [loanId], references: [id], onDelete: Cascade)
  policyId       String?       @db.ObjectId
  policy         Policy?       @relation(fields: [policyId], references: [id], onDelete: Cascade)
  investmentId   String?       @db.ObjectId
  investment     Investment?   @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  // When to remind: `offsetDays` from `anchor` — negative is before
  // (-7 = a week before), 0 is the day itself, positive is an overdue
  // follow-up (+3 = three days after, if still unpaid).
  anchor     ReminderAnchor @default(DUE_DATE)
  offsetDays Int

  channels ReminderChannel[]

  active    Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  jobs NotificationJob[]

  @@index([ownerId, deletedAt])
  @@index([ownerId, category])
}

model NotificationJob {
  id                 String            @id @default(auto()) @map("_id") @db.ObjectId
  notificationRuleId String?           @db.ObjectId
  notificationRule   NotificationRule? @relation(fields: [notificationRuleId], references: [id], onDelete: SetNull)

  ownerId String @db.ObjectId
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  category EventCategory

  // Exclusive Arcs
  billScheduleId String?       @db.ObjectId
  billSchedule   BillSchedule? @relation(fields: [billScheduleId], references: [id], onDelete: Cascade)
  billId         String?       @db.ObjectId
  bill           Bill?         @relation(fields: [billId], references: [id], onDelete: Cascade)
  propertyId     String?       @db.ObjectId
  property       Property?     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leaseId        String?       @db.ObjectId
  lease          Lease?        @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  loanId         String?       @db.ObjectId
  loan           Loan?         @relation(fields: [loanId], references: [id], onDelete: Cascade)
  policyId       String?       @db.ObjectId
  policy         Policy?       @relation(fields: [policyId], references: [id], onDelete: Cascade)
  investmentId   String?       @db.ObjectId
  investment     Investment?   @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  // Set on a property issue's alerts (which have no bill), so resolving the
  // issue can cancel the ones still queued.
  propertyIssueId String? @db.ObjectId

  scheduledFor DateTime
  status       NotificationStatus @default(SCHEDULED)

  channel   ReminderChannel
  recipient String
  title     String
  body      String

  idempotencyKey String? @unique
  batchGroup     String?
  metadata       Json?

  sentAt            DateTime?
  // The provider's id for the message once accepted (e.g. Resend's email
  // id) — what to search for in the provider's logs.
  providerMessageId String?
  failedReason      String?
  retryCount        Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledFor])
  @@index([ownerId])
  // The admin notification log: newest first, optionally per channel.
  @@index([scheduledFor])
  @@index([channel, scheduledFor])
  @@index([propertyIssueId])
}

// ---------------------------------------------------------------------------
// Document Storage
// ---------------------------------------------------------------------------

model Document {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  ownerId     String     @db.ObjectId
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Who can see and change this record: everyone in the household (see
  // `Household`). `ownerId` stays as the person who created it. Optional
  // only so records saved before households existed still load; every write
  // sets it, and `ensureHousehold` backfills older ones.
  householdId String?    @db.ObjectId
  household   Household? @relation(fields: [householdId], references: [id])

  // Exclusive Arcs
  propertyId     String?       @db.ObjectId
  property       Property?     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomId         String?       @db.ObjectId
  room           Room?         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  leaseId        String?       @db.ObjectId
  lease          Lease?        @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  policyId       String?       @db.ObjectId
  policy         Policy?       @relation(fields: [policyId], references: [id], onDelete: Cascade)
  investmentId   String?       @db.ObjectId
  investment     Investment?   @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  loanId         String?       @db.ObjectId
  loan           Loan?         @relation(fields: [loanId], references: [id], onDelete: Cascade)
  billScheduleId String?       @db.ObjectId
  billSchedule   BillSchedule? @relation(fields: [billScheduleId], references: [id], onDelete: Cascade)
  billId         String?       @db.ObjectId
  bill           Bill?         @relation(fields: [billId], references: [id], onDelete: Cascade)

  fileName String
  fileUrl  String
  mimeType String?

  deletedAt  DateTime?
  uploadedAt DateTime  @default(now())

  @@index([ownerId, deletedAt])
  @@index([householdId])
}

// Someone the owner wants reminded about some of their payments — a family
// member, a tenant, an accountant. Guests have no account and never sign
// in: they only receive reminders (and see just the item's name, amount
// and due date). Edited in Settings › Guests.
model Guest {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  ownerId String @db.ObjectId
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  name         String
  relationship String?
  // At least one of email / phone. Phone is E.164 ("+919876543210").
  email        String?
  phone        String?

  // Which channels to use — only EMAIL can deliver today.
  channels    ReminderChannel[]
  // Which kinds of payment they're reminded about.
  categories  EventCategory[]
  // Optional: only bills on these properties (empty = all of them).
  propertyIds String[]          @db.ObjectId
  // true = only on the due day; false = the owner's own schedule.
  dueDayOnly  Boolean           @default(false)

  // Paused by the owner (can be resumed).
  pausedAt   DateTime?
  // The guest used the "stop these reminders" link — final; the owner
  // can't resume them.
  optedOutAt DateTime?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// Households — the unit that owns a portfolio, so it can later be shared
// (a spouse, an advisor). Every user gets a personal household on first use
// (`ensureHousehold` in `src/server/households.ts`).
// ---------------------------------------------------------------------------

enum HouseholdRole {
  OWNER
  MEMBER
}

model Household {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  // The user whose personal household this is, so creating it twice in a
  // race is impossible (the second insert fails on the unique index).
  personalForUserId String?  @unique @db.ObjectId
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  members             HouseholdMember[]
  properties          Property[]
  policies            Policy[]
  investments         Investment[]
  loans               Loan[]
  billSchedules       BillSchedule[]
  bills               Bill[]
  documents           Document[]
  paymentTransactions PaymentTransaction[]
}

model HouseholdMember {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  householdId String        @db.ObjectId
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String        @db.ObjectId
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        HouseholdRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  @@unique([householdId, userId])
  @@index([userId])
}

// One-off data migrations that have run (see `scripts/migrate-data.ts`), so
// re-running the script never applies one twice.
model AppMigration {
  id    String   @id @default(auto()) @map("_id") @db.ObjectId
  name  String   @unique
  ranAt DateTime @default(now())
}

/// better-auth's own rate limiter for the `/api/auth/*` HTTP endpoints
/// (`rateLimit.storage: "database"` in `src/server/better-auth/config.ts`),
/// so limits hold across serverless instances.
model RateLimit {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  key         String @unique
  count       Int
  lastRequest BigInt
}

/// Fixed-window attempt counters for the sign-in, sign-up, password reset
/// and verification-email Server Actions (`src/server/rate-limit.ts`).
/// `key` is "<action>:ip:<address>" or "<action>:email:<address>".
model AuthThrottle {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  count       Int
  windowStart DateTime
}

// Addresses that asked not to be emailed on someone's behalf: a guest who
// used "stop these reminders", a utility recipient who unsubscribed. Keyed
// by address (lower-cased), so deleting and re-adding the guest, or adding
// them to another utility, doesn't start the emails again. `ownerId` is the
// user whose emails they stopped; null means every user's. Only emails sent
// on a user's behalf to other people are checked — never a user's own.
model EmailSuppression {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  // `${ownerId ?? "*"}:${email}`, so each (owner, address) is stored once.
  key       String   @unique
  email     String
  ownerId   String?  @db.ObjectId
  // GUEST_OPT_OUT, RECIPIENT_UNSUBSCRIBE or ALL_USERS.
  reason    String
  createdAt DateTime @default(now())

  @@index([email])
}

// The last run of each background job (see `src/server/cron-runs.ts`), so a
// missed or failing run shows up: `/api/health/cron` reports a job that
// hasn't succeeded on time, for an uptime monitor to alert on.
model CronRun {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  // "notifications", "reminders" or "bills".
  job             String    @unique
  lastStartedAt   DateTime?
  lastSucceededAt DateTime?
  lastFailedAt    DateTime?
  lastError       String?
  // Set when the last successful run still skipped records that threw (see
  // `recordCronRun`); cleared by a clean run.
  lastWarning     String?
  // Where a run that ran out of time stopped, so the next one carries on
  // from there instead of starting over (the reminder generator).
  cursor          String?
}
