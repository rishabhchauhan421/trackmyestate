// Prisma schema for Better Auth & Asset Management Platform
// Database: MongoDB

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core / Auth Models
// ---------------------------------------------------------------------------

model Post {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String @db.ObjectId

  @@index([name])
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  
  // Base currency derived at the User level
  currency      Currency  @default(INR)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Auth relations
  sessions      Session[]
  accounts      Account[]
  posts         Post[]

  // Domain relations
  properties        Property[]
  policies          Policy[]
  investments       Investment[]
  loans             Loan[]
  financialEvents   FinancialEvent[]
  bills             Bill[]
  billSchedules     BillSchedule[]
  notificationRules NotificationRule[]
  notificationJobs  NotificationJob[]
  documents         Document[]
  auditLogs         AuditLog[]
  transactions      PaymentTransaction[]

  @@map("user")
}

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  accountId             String
  providerId            String
  userId                String    @db.ObjectId
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ---------------------------------------------------------------------------
// Enums — Domain & Financial Assets
// ---------------------------------------------------------------------------

enum Currency {
  INR
  USD
  EUR
  GBP
  CAD
  AED
  SGD
  AUD
}

enum PropertyType {
  SELF_OCCUPIED
  RENTED
  UNDER_CONSTRUCTION
  INVESTMENT
}

enum OccupancyStatus {
  VACANT
  OCCUPIED
  UNDER_MAINTENANCE
}

enum BillType {
  ELECTRICITY
  WATER
  PROPERTY_TAX
  MAINTENANCE
  GAS
  INTERNET
  OTHER
}

enum BillingType {
  FIXED
  VARIABLE
}

enum BillRecurrence {
  WEEKLY
  BI_WEEKLY
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum PaymentStatus {
  DUE
  PAID
  OVERDUE
  PARTIALLY_PAID
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  UPI
  CHEQUE
  AUTO_DEBIT
  OTHER
}

enum PolicyType {
  TERM_LIFE
  ENDOWMENT
  MONEY_BACK
  ULIP
  HEALTH
  VEHICLE
  HOME
}

enum PolicyStatus {
  ACTIVE
  LAPSED
  MATURED
  CLAIMED
  CANCELLED
}

enum PremiumFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  SINGLE
}

enum ClaimStatus {
  FILED
  APPROVED
  REJECTED
  SETTLED
}

enum InvestmentType {
  PROPERTY
  FIXED_DEPOSIT
  RECURRING_DEPOSIT
  MUTUAL_FUND
  STOCKS
  GOLD
  BUSINESS
  PPF
  NPS
}

enum LoanType {
  HOME_LOAN
  LOAN_AGAINST_PROPERTY
  PERSONAL_LOAN
  VEHICLE_LOAN
  EDUCATION_LOAN
  GOLD_LOAN
}

enum LinkedAssetType {
  PROPERTY
  POLICY
  INVESTMENT
  NONE
}

enum FinancialEventType {
  INFLOW
  OUTFLOW
}

enum FinancialEventSource {
  RENT
  BILL
  PREMIUM
  PAYOUT
  EMI
  RETURN
  CLAIM_SETTLEMENT
}

enum DocumentOwnerType {
  PROPERTY
  ROOM
  TENANT
  POLICY
  CLAIM
  INVESTMENT
  LOAN
}

// ---------------------------------------------------------------------------
// Enums — Scalable Notification Engine
// ---------------------------------------------------------------------------

enum ReminderChannel {
  EMAIL
  PUSH
  WHATSAPP
  SMS
}

enum EntityType {
  UTILITY_BILL
  LOAN_EMI
  RENT_PAYMENT
  POLICY_PREMIUM
  INVESTMENT_MATURITY
  CUSTOM
}

enum NotificationTrigger {
  BEFORE_DUE
  ON_DUE_DATE
  OVERDUE
  PAYMENT_RECEIVED
}

enum NotificationStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  CANCELLED
  SKIPPED
}

// ---------------------------------------------------------------------------
// Domain Models — Real Estate, Rental & Utility Tracking
// ---------------------------------------------------------------------------

model Property {
  id                    String       @id @default(auto()) @map("_id") @db.ObjectId
  ownerId               String       @db.ObjectId
  owner                 User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                  String
  type                  PropertyType
  addressLine1          String
  addressLine2          String?
  city                  String
  state                 String
  pinCode               String
  country               String       @default("India")
  
  // Inherits from User, overrideable if needed
  currency              Currency?
  purchasePrice         Float?
  currentEstimatedValue Float?
  purchaseDate          DateTime?
  photos                String[]
  
  deletedAt             DateTime?    // Soft delete
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  rooms         Room[]
  tenants       Tenant[]
  billSchedules BillSchedule[]
  bills         Bill[]

  @@index([ownerId])
  @@index([deletedAt])
}

model Room {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  propertyId      String          @db.ObjectId
  property        Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  label           String
  floor           String?
  areaSqft        Float?
  occupancyStatus OccupancyStatus @default(VACANT)
  
  deletedAt       DateTime?       // Soft delete
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenants Tenant[]

  @@index([propertyId])
  @@index([deletedAt])
}

model Tenant {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  propertyId    String    @db.ObjectId
  property      Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomId        String?   @db.ObjectId
  room          Room?     @relation(fields: [roomId], references: [id])
  name          String
  phone         String
  email         String?
  leaseStart    DateTime
  leaseEnd      DateTime?
  rentAmount    Float
  depositAmount Float
  currency      Currency?
  active        Boolean   @default(true)
  
  deletedAt     DateTime? // Soft delete
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([propertyId])
  @@index([roomId])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// BillSchedule — the recurring (or one-time) template that generates `Bill`
// instances. Generalized from what used to be just `Utility`: discriminated
// by `category`/reused enums the same way `Bill` is, so the same model can
// back a property's utility bills (`category: "BILL"`, scoped by
// `propertyId`) or a loan's EMI schedule (`category: "EMI"`, `sourceId`
// pointing at the `Loan`). `Policy` (premiums) and `Tenant` (rent) can plug
// into this the same way once that's built — nothing wires them up yet.
// ---------------------------------------------------------------------------

model BillSchedule {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  ownerId String @db.ObjectId
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  category FinancialEventSource // RENT | BILL | PREMIUM | EMI

  // Polymorphic parent, no declared relation (same convention as
  // `Bill.sourceId`) — Loan.id for "EMI". Left unset for "BILL", whose only
  // parent is the Property itself (propertyId below).
  sourceId String? @db.ObjectId

  // Populated only for "BILL" (and, eventually, "RENT").
  propertyId String?   @db.ObjectId
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // --- BILL (utility)-specific ---
  billType         BillType?
  provider         String?
  accountNumber    String?
  meterNumber      String?
  billingType      BillingType?
  autoGenerateBill Boolean?

  // --- Shared scheduling fields ---
  recurrence       BillRecurrence @default(MONTHLY)
  dueDay           Int            // 1-31 (day of month) or 1-7 (day of week)
  dueMonth         Int?           // 1-12 (for YEARLY recurrence)
  reminderLeadDays Int            @default(7)
  defaultAmount    Float?
  currency         Currency?

  // --- EMI-specific ---
  tenureMonths Int? // total number of cycles for a finite schedule; null = indefinite

  active    Boolean   @default(true)
  deletedAt DateTime? // Soft delete
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  recipients BillScheduleRecipient[]

  @@index([propertyId])
  @@index([category, sourceId])
  @@index([ownerId])
  @@index([deletedAt])
}

model BillScheduleRecipient {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  billScheduleId String       @db.ObjectId
  billSchedule   BillSchedule @relation(fields: [billScheduleId], references: [id], onDelete: Cascade)

  name         String
  email        String
  phone        String?
  notifyOnDue  Boolean   @default(true)
  notifyOnPaid Boolean   @default(false)

  deletedAt    DateTime? // Soft delete
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([billScheduleId])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Domain Models — Insurance Policies
// ---------------------------------------------------------------------------

model Policy {
  id                  String       @id @default(auto()) @map("_id") @db.ObjectId
  ownerId             String       @db.ObjectId
  owner               User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type                PolicyType
  insurer             String
  policyNumber        String
  holderName          String
  nominees            String[]
  startDate           DateTime
  tenureYears         Int?
  status              PolicyStatus @default(ACTIVE)
  sumAssured          Float?
  currency            Currency?
  roomRentLimit       Float?
  coPayPercent        Float?
  waitingPeriodMonths Int?
  networkHospitals    String[]
  
  deletedAt           DateTime?    // Soft delete
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([ownerId])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Domain Models — Investments & Loans
// ---------------------------------------------------------------------------

model Investment {
  id                    String         @id @default(auto()) @map("_id") @db.ObjectId
  ownerId               String         @db.ObjectId
  owner                 User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                  String
  type                  InvestmentType
  institution           String?
  investedDate          DateTime
  capitalDeployed       Float
  currency              Currency?
  expectedReturnType    String?
  expectedReturnDate    DateTime?
  targetRoiPercent      Float?
  currentEstimatedValue Float?
  
  deletedAt             DateTime?      // Soft delete
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([ownerId])
  @@index([deletedAt])
}

// EMI schedule (tenureMonths, due day, EMI amount) lives on this loan's
// `BillSchedule` row (category "EMI"), not here — see the `BillSchedule`
// model comment. `startDate` stays here since it's a loan fact (when it was
// disbursed), not a billing-schedule concept.
model Loan {
  id                  String          @id @default(auto()) @map("_id") @db.ObjectId
  ownerId             String          @db.ObjectId
  owner               User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  lender              String
  type                LoanType
  principal           Float
  currency            Currency?
  interestRatePercent Float
  startDate           DateTime
  outstandingBalance  Float
  linkedAssetType     LinkedAssetType @default(NONE)
  linkedAssetId       String?         @db.ObjectId

  deletedAt           DateTime?       // Soft delete
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([ownerId])
  @@index([deletedAt])
}

model FinancialEvent {
  id          String               @id @default(auto()) @map("_id") @db.ObjectId
  ownerId     String               @db.ObjectId
  owner       User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type        FinancialEventType
  source      FinancialEventSource
  sourceId    String               @db.ObjectId
  amount      Float
  currency    Currency?
  dueDate     DateTime
  status      PaymentStatus        @default(DUE)
  description String?
  
  deletedAt   DateTime?            // Soft delete
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([ownerId])
  @@index([dueDate])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Bill — the single "amount due on a date, later paid/received" record.
// Replaces what used to be UtilityBill / EMIPayment / PremiumPayment /
// RentPayment / Payout / Return / Claim: every one of those was the same
// shape (dueDate, amount, status, paidDate) with a handful of
// category-specific extras, so they're one model now, discriminated by
// `category` (reusing `FinancialEventSource`, the same enum FinancialEvent
// already uses for this) and `direction` (reusing `FinancialEventType`). A
// Bill is always a single, one-time occurrence — recurrence lives on the
// template that generates them (Utility, Loan, Policy, a Tenant lease),
// which either spawns one Bill once or spawns a new one each cycle.
// ---------------------------------------------------------------------------

model Bill {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  ownerId String @db.ObjectId
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  category  FinancialEventSource // RENT | BILL | PREMIUM | PAYOUT | EMI | RETURN | CLAIM_SETTLEMENT
  direction FinancialEventType   // INFLOW | OUTFLOW

  // Polymorphic parent, no declared relation (same convention as
  // FinancialEvent.sourceId) — Tenant.id / Utility.id / Loan.id / Policy.id
  // / Investment.id, depending on `category`.
  sourceId String @db.ObjectId

  // Populated only for RENT and BILL, so property-scoped queries (the
  // utilities page, /properties' overdue-amount sum) don't need a join.
  propertyId String?   @db.ObjectId
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  dueDate    DateTime
  amount     Float
  currency   Currency?
  status     PaymentStatus @default(DUE)
  paidDate   DateTime?
  paidAmount Float?
  notes      String?

  // --- Category-specific fields (nullable; only one group populated per row) ---
  // EMI
  installmentNumber  Int?
  principalComponent Float?
  interestComponent  Float?
  // BILL (utility)
  previousMeterValue Float?
  currentMeterValue  Float?
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  billDocumentUrl    String?
  receiptDocumentUrl String?
  // PREMIUM
  frequency       PremiumFrequency?
  gracePeriodDays Int?
  // PAYOUT / RETURN
  label String?
  // CLAIM_SETTLEMENT — `claimStatus` kept for extra granularity alongside
  // the shared `status`, since FILED/APPROVED/REJECTED/SETTLED doesn't map
  // 1:1 onto PaymentStatus.
  claimStatus ClaimStatus?
  description String?

  deletedAt DateTime? // Soft delete
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([ownerId])
  @@index([category, sourceId])
  @@index([propertyId])
  @@index([dueDate, status])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Universal Payment Ledger & Audit Trail
// ---------------------------------------------------------------------------

model PaymentTransaction {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  ownerId         String        @db.ObjectId
  owner           User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  entityType      EntityType
  entityId        String        @db.ObjectId
  
  amount          Float
  currency        Currency?
  paymentMethod   PaymentMethod @default(BANK_TRANSFER)
  referenceNumber String?       // Bank UTR, Cheque No, Transaction ID
  receiptUrl      String?
  
  paidAt          DateTime      @default(now())
  notes           String?

  deletedAt       DateTime?     // Soft delete
  createdAt       DateTime      @default(now())

  @@index([ownerId])
  @@index([entityType, entityId])
  @@index([deletedAt])
}

model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String?  @db.ObjectId
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  action     String   // e.g., "CREATE_UTILITY", "MARK_PAID_EMI", "UPDATE_TENANT"
  entityType String   // e.g., "UtilityBill", "Loan"
  entityId   String   @db.ObjectId
  
  changes    Json?    // Snapshot of before/after delta
  ipAddress  String?
  
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Scalable Notification Engine
// ---------------------------------------------------------------------------

model NotificationRule {
  id             String              @id @default(auto()) @map("_id") @db.ObjectId
  ownerId        String              @db.ObjectId
  owner          User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  entityType     EntityType
  entityId       String              @db.ObjectId
  
  trigger        NotificationTrigger @default(BEFORE_DUE)
  leadDays       Int                 @default(3)
  
  channels       ReminderChannel[]
  recipients     String[]            // Email addresses or phone numbers
  
  active         Boolean             @default(true)
  deletedAt      DateTime?           // Soft delete
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  jobs           NotificationJob[]

  @@index([ownerId])
  @@index([entityType, entityId])
  @@index([deletedAt])
}

model NotificationJob {
  id                 String             @id @default(auto()) @map("_id") @db.ObjectId
  notificationRuleId String?            @db.ObjectId
  notificationRule   NotificationRule?  @relation(fields: [notificationRuleId], references: [id], onDelete: SetNull)

  ownerId            String             @db.ObjectId
  owner              User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  entityType         EntityType
  entityId           String             @db.ObjectId
  
  scheduledFor       DateTime
  status             NotificationStatus @default(SCHEDULED)
  
  channel            ReminderChannel
  recipient          String
  title              String
  body               String
  
  idempotencyKey     String?            @unique
  batchGroup         String?            
  metadata           Json?              

  sentAt             DateTime?
  failedReason       String?
  retryCount         Int                @default(0)

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([status, scheduledFor])
  @@index([entityType, entityId])
  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// Document Storage
// ---------------------------------------------------------------------------

model Document {
  id         String            @id @default(auto()) @map("_id") @db.ObjectId
  ownerId    String            @db.ObjectId
  owner      User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerType  DocumentOwnerType
  ownerRefId String            @db.ObjectId
  fileName   String
  fileUrl    String
  mimeType   String?
  
  deletedAt  DateTime?         // Soft delete
  uploadedAt DateTime          @default(now())

  @@index([ownerId])
  @@index([ownerType, ownerRefId])
  @@index([deletedAt])
}