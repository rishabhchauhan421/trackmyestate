// Prisma schema for Better Auth & Asset Management Platform
// Database: MongoDB

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core / Auth Models
// ---------------------------------------------------------------------------

model Post {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String @db.ObjectId

  @@index([name])
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  
  currency      Currency  @default(INR)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  sessions      Session[]
  accounts      Account[]
  posts         Post[]

  // Domain relations
  properties        Property[]
  policies          Policy[]
  investments       Investment[]
  loans             Loan[]
  bills             Bill[]
  billSchedules     BillSchedule[]
  notificationRules NotificationRule[]
  notificationJobs  NotificationJob[]
  documents         Document[]
  auditLogs         AuditLog[]
  transactions      PaymentTransaction[]

  @@map("user")
}

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  accountId             String
  providerId            String
  userId                String    @db.ObjectId
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ---------------------------------------------------------------------------
// Embedded Document Types (MongoDB Native)
// ---------------------------------------------------------------------------

type Recipient {
  name         String
  email        String
  phone        String?
  notifyOnDue  Boolean @default(true)
  notifyOnPaid Boolean @default(false)
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Currency {
  INR
  USD
  EUR
  GBP
  CAD
  AED
  SGD
  AUD
}

enum PropertyType {
  SELF_OCCUPIED
  RENTED
  UNDER_CONSTRUCTION
  INVESTMENT
}

enum BillType {
  ELECTRICITY
  WATER
  PROPERTY_TAX
  MAINTENANCE
  GAS
  INTERNET
  OTHER
}

enum BillingType {
  FIXED
  VARIABLE
}

enum BillRecurrence {
  WEEKLY
  BI_WEEKLY
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum PaymentStatus {
  DUE
  PAID
  OVERDUE
  PARTIALLY_PAID
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  UPI
  CHEQUE
  AUTO_DEBIT
  OTHER
}

enum PolicyType {
  TERM_LIFE
  ENDOWMENT
  MONEY_BACK
  ULIP
  HEALTH
  VEHICLE
  HOME
}

enum PolicyStatus {
  ACTIVE
  LAPSED
  MATURED
  CLAIMED
  CANCELLED
}

enum PremiumFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  SINGLE
}

enum ClaimStatus {
  FILED
  APPROVED
  REJECTED
  SETTLED
}

enum InvestmentType {
  PROPERTY
  FIXED_DEPOSIT
  RECURRING_DEPOSIT
  MUTUAL_FUND
  STOCKS
  GOLD
  BUSINESS
  PPF
  NPS
}

enum LoanType {
  HOME_LOAN
  LOAN_AGAINST_PROPERTY
  PERSONAL_LOAN
  VEHICLE_LOAN
  EDUCATION_LOAN
  GOLD_LOAN
}

enum EventCategory {
  RENT
  UTILITY_BILL
  PREMIUM
  EMI
  INVESTMENT_RETURN
  PAYOUT
  CLAIM_SETTLEMENT
  CUSTOM
}

enum FinancialEventType {
  INFLOW
  OUTFLOW
}

enum ReminderChannel {
  EMAIL
  PUSH
  WHATSAPP
  SMS
}

enum NotificationTrigger {
  BEFORE_DUE
  ON_DUE_DATE
  OVERDUE
  PAYMENT_RECEIVED
}

enum NotificationStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  CANCELLED
  SKIPPED
}

// ---------------------------------------------------------------------------
// Domain Models — Real Estate, Rental & Utility Tracking
// ---------------------------------------------------------------------------

model Property {
  id                    String       @id @default(auto()) @map("_id") @db.ObjectId
  ownerId               String       @db.ObjectId
  owner                 User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                  String
  type                  PropertyType
  addressLine1          String
  addressLine2          String?
  city                  String
  state                 String
  pinCode               String
  country               String       @default("India")
  
  currency              Currency?
  purchasePrice         Float?
  currentEstimatedValue Float?
  purchaseDate          DateTime?
  photos                String[]
  
  deletedAt             DateTime?    
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  rooms             Room[]
  leases            Lease[]
  billSchedules     BillSchedule[]
  bills             Bill[]
  loans             Loan[]               // If property is linked to a loan
  documents         Document[]
  transactions      PaymentTransaction[]
  notificationRules NotificationRule[]
  notificationJobs  NotificationJob[]

  @@index([ownerId, deletedAt])
}

model Room {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  propertyId      String          @db.ObjectId
  property        Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  label           String
  floor           String?
  areaSqft        Float?
  
  // occupancyStatus removed — derived dynamically in queries based on active Lease

  deletedAt       DateTime?       
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  leases    Lease[]
  documents Document[]

  @@index([propertyId, deletedAt])
}

model Lease {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  propertyId    String    @db.ObjectId
  property      Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomId        String?   @db.ObjectId
  room          Room?     @relation(fields: [roomId], references: [id])
  
  tenantName    String    @map("name")
  tenantPhone   String    @map("phone")
  tenantEmail   String?   @map("email")
  leaseStart    DateTime
  leaseEnd      DateTime?
  rentAmount    Float
  rentDueDay    Int?      
  depositAmount Float
  currency      Currency?
  active        Boolean   @default(true)

  deletedAt     DateTime? 
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  billSchedules     BillSchedule[]
  bills             Bill[]
  documents         Document[]
  transactions      PaymentTransaction[]
  notificationRules NotificationRule[]
  notificationJobs  NotificationJob[]

  @@map("Tenant")
  @@index([propertyId, deletedAt])
  @@index([roomId])
}

// ---------------------------------------------------------------------------
// BillSchedule & Bills (Exclusive Arcs replace Polymorphic Strings)
// ---------------------------------------------------------------------------

model BillSchedule {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  ownerId String @db.ObjectId
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  category EventCategory 
  
  // Exclusive Arcs (Only one will be populated per row)
  propertyId   String?     @db.ObjectId
  property     Property?   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leaseId      String?     @db.ObjectId
  lease        Lease?      @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  loanId       String?     @db.ObjectId
  loan         Loan?       @relation(fields: [loanId], references: [id], onDelete: Cascade)
  policyId     String?     @db.ObjectId
  policy       Policy?     @relation(fields: [policyId], references: [id], onDelete: Cascade)
  investmentId String?     @db.ObjectId
  investment   Investment? @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  billType         BillType?
  provider         String?
  accountNumber    String?
  meterNumber      String?
  billingType      BillingType?
  autoGenerateBill Boolean?

  recurrence       BillRecurrence @default(MONTHLY)
  dueDay           Int            
  dueMonth         Int?           
  reminderLeadDays Int            @default(7)
  defaultAmount    Float?
  currency         Currency?
  tenureMonths     Int? 

  active    Boolean   @default(true)
  deletedAt DateTime? 
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  recipients        Recipient[]    // MongoDB Embedded Array
  
  bills             Bill[]
  documents         Document[]
  notificationRules NotificationRule[]
  notificationJobs  NotificationJob[]

  @@index([ownerId, deletedAt])
  @@index([propertyId])
  @@index([leaseId])
  @@index([loanId])
  @@index([policyId])
}

model Bill {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  ownerId String @db.ObjectId
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  category  EventCategory 
  direction FinancialEventType

  // Exclusive Arcs
  billScheduleId String?       @db.ObjectId
  billSchedule   BillSchedule? @relation(fields: [billScheduleId], references: [id], onDelete: SetNull)
  propertyId     String?       @db.ObjectId
  property       Property?     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leaseId        String?       @db.ObjectId
  lease          Lease?        @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  loanId         String?       @db.ObjectId
  loan           Loan?         @relation(fields: [loanId], references: [id], onDelete: Cascade)
  policyId       String?       @db.ObjectId
  policy         Policy?       @relation(fields: [policyId], references: [id], onDelete: Cascade)
  investmentId   String?       @db.ObjectId
  investment     Investment?   @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  dueDate    DateTime
  amount     Float
  currency   Currency?
  status     PaymentStatus @default(DUE)
  paidDate   DateTime?
  paidAmount Float?
  notes      String?

  installmentNumber  Int?
  principalComponent Float?
  interestComponent  Float?
  previousMeterValue Float?
  currentMeterValue  Float?
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  billDocumentUrl    String?
  receiptDocumentUrl String?
  frequency          PremiumFrequency?
  gracePeriodDays    Int?
  label              String?
  claimStatus        ClaimStatus?
  description        String?

  deletedAt DateTime? 
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  transactions      PaymentTransaction[]
  documents         Document[]
  notificationRules NotificationRule[]
  notificationJobs  NotificationJob[]

  @@index([ownerId, deletedAt])
  @@index([dueDate, status])
  @@index([propertyId])
  @@index([leaseId])
  @@index([loanId])
}

// ---------------------------------------------------------------------------
// Domain Models — Insurance Policies, Investments & Loans
// ---------------------------------------------------------------------------

model Policy {
  id                  String       @id @default(auto()) @map("_id") @db.ObjectId
  ownerId             String       @db.ObjectId
  owner               User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type                PolicyType
  insurer             String
  policyNumber        String
  holderName          String
  nominees            String[]
  startDate           DateTime
  tenureYears         Int?
  status              PolicyStatus @default(ACTIVE)
  sumAssured          Float?
  currency            Currency?
  roomRentLimit       Float?
  coPayPercent        Float?
  waitingPeriodMonths Int?
  networkHospitals    String[]
  
  deletedAt           DateTime?    
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  billSchedules     BillSchedule[]
  bills             Bill[]
  loans             Loan[]
  documents         Document[]
  transactions      PaymentTransaction[]
  notificationRules NotificationRule[]
  notificationJobs  NotificationJob[]

  @@index([ownerId, deletedAt])
}

model Investment {
  id                    String         @id @default(auto()) @map("_id") @db.ObjectId
  ownerId               String         @db.ObjectId
  owner                 User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                  String
  type                  InvestmentType
  institution           String?
  investedDate          DateTime
  capitalDeployed       Float
  currency              Currency?
  expectedReturnType    String?
  expectedReturnDate    DateTime?
  targetRoiPercent      Float?
  currentEstimatedValue Float?
  
  deletedAt             DateTime?      
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  billSchedules     BillSchedule[]
  bills             Bill[]
  loans             Loan[]
  documents         Document[]
  transactions      PaymentTransaction[]
  notificationRules NotificationRule[]
  notificationJobs  NotificationJob[]

  @@index([ownerId, deletedAt])
}

model Loan {
  id                  String          @id @default(auto()) @map("_id") @db.ObjectId
  ownerId             String          @db.ObjectId
  owner               User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  lender              String
  type                LoanType
  principal           Float
  currency            Currency?
  interestRatePercent Float
  startDate           DateTime
  outstandingBalance  Float
  
  // Exclusive Arcs replace LinkedAssetId
  linkedPropertyId    String?         @db.ObjectId
  linkedProperty      Property?       @relation(fields: [linkedPropertyId], references: [id], onDelete: SetNull)
  linkedPolicyId      String?         @db.ObjectId
  linkedPolicy        Policy?         @relation(fields: [linkedPolicyId], references: [id], onDelete: SetNull)
  linkedInvestmentId  String?         @db.ObjectId
  linkedInvestment    Investment?     @relation(fields: [linkedInvestmentId], references: [id], onDelete: SetNull)

  deletedAt           DateTime?       
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  billSchedules     BillSchedule[]
  bills             Bill[]
  documents         Document[]
  transactions      PaymentTransaction[]
  notificationRules NotificationRule[]
  notificationJobs  NotificationJob[]

  @@index([ownerId, deletedAt])
}

// ---------------------------------------------------------------------------
// Universal Payment Ledger & Audit Trail
// ---------------------------------------------------------------------------

model PaymentTransaction {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  ownerId         String        @db.ObjectId
  owner           User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  category        EventCategory
  
  // Exclusive Arcs
  billId          String?       @db.ObjectId
  bill            Bill?         @relation(fields: [billId], references: [id], onDelete: Cascade)
  propertyId      String?       @db.ObjectId
  property        Property?     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leaseId         String?       @db.ObjectId
  lease           Lease?        @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  loanId          String?       @db.ObjectId
  loan            Loan?         @relation(fields: [loanId], references: [id], onDelete: Cascade)
  policyId        String?       @db.ObjectId
  policy          Policy?       @relation(fields: [policyId], references: [id], onDelete: Cascade)
  investmentId    String?       @db.ObjectId
  investment      Investment?   @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  amount          Float
  currency        Currency?
  paymentMethod   PaymentMethod @default(BANK_TRANSFER)
  referenceNumber String?       
  receiptUrl      String?
  
  paidAt          DateTime      @default(now())
  notes           String?

  deletedAt       DateTime?     
  createdAt       DateTime      @default(now())

  @@index([ownerId, deletedAt])
  @@index([billId])
}

model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String?  @db.ObjectId
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  action     String   
  
  // Note: These intentionally remain standard Strings. Audit logs are immutable 
  // historical ledgers that must persist even if the source entity is hard-deleted.
  entityType String   
  entityId   String   @db.ObjectId
  
  changes    Json?    
  ipAddress  String?
  
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Scalable Notification Engine
// ---------------------------------------------------------------------------

model NotificationRule {
  id             String              @id @default(auto()) @map("_id") @db.ObjectId
  ownerId        String              @db.ObjectId
  owner          User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  category       EventCategory
  
  // Exclusive Arcs
  billScheduleId String?             @db.ObjectId
  billSchedule   BillSchedule?       @relation(fields: [billScheduleId], references: [id], onDelete: Cascade)
  billId         String?             @db.ObjectId
  bill           Bill?               @relation(fields: [billId], references: [id], onDelete: Cascade)
  propertyId     String?             @db.ObjectId
  property       Property?           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leaseId        String?             @db.ObjectId
  lease          Lease?              @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  loanId         String?             @db.ObjectId
  loan           Loan?               @relation(fields: [loanId], references: [id], onDelete: Cascade)
  policyId       String?             @db.ObjectId
  policy         Policy?             @relation(fields: [policyId], references: [id], onDelete: Cascade)
  investmentId   String?             @db.ObjectId
  investment     Investment?         @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  trigger        NotificationTrigger @default(BEFORE_DUE)
  leadDays       Int                 @default(3)
  
  channels       ReminderChannel[]
  recipients     String[]            
  
  active         Boolean             @default(true)
  deletedAt      DateTime?           
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  jobs           NotificationJob[]

  @@index([ownerId, deletedAt])
}

model NotificationJob {
  id                 String             @id @default(auto()) @map("_id") @db.ObjectId
  notificationRuleId String?            @db.ObjectId
  notificationRule   NotificationRule?  @relation(fields: [notificationRuleId], references: [id], onDelete: SetNull)

  ownerId            String             @db.ObjectId
  owner              User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  category           EventCategory
  
  // Exclusive Arcs
  billScheduleId String?             @db.ObjectId
  billSchedule   BillSchedule?       @relation(fields: [billScheduleId], references: [id], onDelete: Cascade)
  billId         String?             @db.ObjectId
  bill           Bill?               @relation(fields: [billId], references: [id], onDelete: Cascade)
  propertyId     String?             @db.ObjectId
  property       Property?           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leaseId        String?             @db.ObjectId
  lease          Lease?              @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  loanId         String?             @db.ObjectId
  loan           Loan?               @relation(fields: [loanId], references: [id], onDelete: Cascade)
  policyId       String?             @db.ObjectId
  policy         Policy?             @relation(fields: [policyId], references: [id], onDelete: Cascade)
  investmentId   String?             @db.ObjectId
  investment     Investment?         @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  
  scheduledFor       DateTime
  status             NotificationStatus @default(SCHEDULED)
  
  channel            ReminderChannel
  recipient          String
  title              String
  body               String
  
  idempotencyKey     String?            @unique
  batchGroup         String?            
  metadata           Json?              

  sentAt             DateTime?
  failedReason       String?
  retryCount         Int                @default(0)

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([status, scheduledFor])
  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// Document Storage
// ---------------------------------------------------------------------------

model Document {
  id         String            @id @default(auto()) @map("_id") @db.ObjectId
  ownerId    String            @db.ObjectId
  owner      User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  // Exclusive Arcs
  propertyId     String?       @db.ObjectId
  property       Property?     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomId         String?       @db.ObjectId
  room           Room?         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  leaseId        String?       @db.ObjectId
  lease          Lease?        @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  policyId       String?       @db.ObjectId
  policy         Policy?       @relation(fields: [policyId], references: [id], onDelete: Cascade)
  investmentId   String?       @db.ObjectId
  investment     Investment?   @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  loanId         String?       @db.ObjectId
  loan           Loan?         @relation(fields: [loanId], references: [id], onDelete: Cascade)
  billScheduleId String?       @db.ObjectId
  billSchedule   BillSchedule? @relation(fields: [billScheduleId], references: [id], onDelete: Cascade)
  billId         String?       @db.ObjectId
  bill           Bill?         @relation(fields: [billId], references: [id], onDelete: Cascade)

  fileName   String
  fileUrl    String
  mimeType   String?
  
  deletedAt  DateTime?         
  uploadedAt DateTime          @default(now())

  @@index([ownerId, deletedAt])
}