{
  "regions": ["bom1"],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "ignoreCommand": "[ \"$VERCEL_ENV\" != \"production\" ]",
  "crons": [
    {
      "path": "/api/cron/notifications",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/cron/bills",
      "schedule": "0 3 * * *"
    }
  ]
}
